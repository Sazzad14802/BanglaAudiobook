APP_NAME="Bangla AudioBook - TTS Service"
APP_VERSION="1.0.0"
DEBUG=true
HOST="0.0.0.0"
PORT=8001

# Model settings
BANGLA_MODEL_REPO="EMTIAZZ/bangladeshi-bangla-tts-vits"
XTTS_MODEL_NAME="tts_models/multilingual/multi-dataset/xtts_v2"
USE_CUDA=false

# Platform API integration
PLATFORM_API_URL="http://localhost:8000/api/v1"
OUTPUT_DIR="output"
