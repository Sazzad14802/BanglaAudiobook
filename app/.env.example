# Copy to app/.env (never commit .env). Restart `npx expo start` after changes.

# Leave empty for local development: the app finds the API on the LAN automatically.
# Set it for APK builds or tunnels, e.g. https://bornoverse-api.onrender.com
EXPO_PUBLIC_API_URL=

# Supabase project URL for Google sign-in (Project Settings → API → Project URL).
# The anon key is NOT needed in the app; the Platform API holds it.
EXPO_PUBLIC_SUPABASE_URL=
