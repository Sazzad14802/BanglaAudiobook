# ==============================================================================
# Environment Configuration for Audiobook Platform API
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env to version control.
# ==============================================================================

# Application
APP_NAME="Audiobook Platform API"
APP_VERSION="0.1.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# Database
# Async connection for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/audiobook_db
# Sync connection for Alembic migrations (psycopg)
SYNC_DATABASE_URL=postgresql+psycopg://postgres:12345@localhost:5432/audiobook_db

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Model Runner Integration Boundary
MODEL_RUNNER_DISPATCHER=http
MODEL_RUNNER_URL=http://localhost:8001/jobs
